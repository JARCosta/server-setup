# Copy to .env: cp .env.example .env && chmod 600 .env
#
# Tailscale: https://login.tailscale.com/admin/settings/keys → Generate auth key
# Prefer a reusable, pre-authorized key for this server; consider disabling key expiry for the node.
TS_AUTHKEY=tskey-auth-REPLACE_ME

# MariaDB (Nextcloud app user + root backup login)
MYSQL_PASSWORD=change-me-long-random
MARIADB_ROOT_PASSWORD=change-me-other-long-random

# Run: docker compose up -d
# PC: install Tailscale, then browser → http://nextcloud or http://<tailscale-ip>
# If Nextcloud warns about the host: add the hostname or IP under Admin → Settings → Trusted domains.
